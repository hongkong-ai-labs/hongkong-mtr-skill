{
  // Pure Cloudflare Workers (V8 isolate) MCP endpoint.
  // Deploy from the repository root with: npx wrangler deploy
  // The legacy Container fallback is in cloudflare/wrangler.container.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtr-hk-mcp",
  "main": "worker/build/worker/shim.mjs",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bash worker/build.sh"
  }
}
